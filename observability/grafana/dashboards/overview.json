{
    "__inputs": [],
    "__requires": [
        {
            "type": "grafana",
            "id": "grafana",
            "name": "Grafana",
            "version": "9.x"
        },
        {
            "type": "panel",
            "id": "timeseries",
            "name": "Time series",
            "version": "9.x"
        },
        { "type": "panel", "id": "stat", "name": "Stat", "version": "9.x" },
        {
            "type": "datasource",
            "id": "prometheus",
            "name": "Prometheus",
            "version": "2.x"
        }
    ],
    "title": "BeeTrack Overview",
    "tags": ["beetrack", "fastapi", "redis"],
    "timezone": "browser",
    "schemaVersion": 37,
    "version": 1,
    "refresh": "10s",
    "templating": {
        "list": [
            {
                "type": "query",
                "name": "endpoint",
                "label": "Endpoint",
                "hide": 0,
                "datasource": "Prometheus",
                "definition": "label_values(http_requests_total, endpoint)",
                "query": "label_values(http_requests_total, endpoint)",
                "refresh": 1,
                "includeAll": true,
                "multi": true,
                "regex": "",
                "sort": 1,
                "current": {
                    "selected": true,
                    "tags": [],
                    "text": ["All"],
                    "value": [".*"]
                },
                "options": []
            }
        ]
    },
    "panels": [
        {
            "type": "stat",
            "title": "HTTP RPS (1m)",
            "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum(rate(http_requests_total[1m]))",
                    "legendFormat": "rps"
                }
            ],
            "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
            "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
        },
        {
            "type": "timeseries",
            "title": "HTTP P95 latency (ms)",
            "gridPos": { "h": 6, "w": 9, "x": 6, "y": 0 },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "1000 * histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, method))",
                    "legendFormat": "{{method}}"
                }
            ],
            "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
        },
        {
            "type": "timeseries",
            "title": "Cache hit ratio",
            "gridPos": { "h": 6, "w": 9, "x": 15, "y": 0 },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum(rate(cache_hits_total[5m])) / clamp_min(sum(rate(cache_hits_total[5m])) + sum(rate(cache_misses_total[5m])), 1e-9)",
                    "legendFormat": "hit_ratio"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "red", "value": 0 },
                            { "color": "yellow", "value": 0.7 },
                            { "color": "green", "value": 0.9 }
                        ]
                    }
                },
                "overrides": []
            }
        },
        {
            "type": "timeseries",
            "title": "DB slow queries",
            "gridPos": { "h": 6, "w": 8, "x": 0, "y": 6 },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum(rate(db_slow_queries_total[5m])) by (table)",
                    "legendFormat": "{{table}}"
                }
            ],
            "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
        },
        {
            "type": "timeseries",
            "title": "Rate limit hits",
            "gridPos": { "h": 6, "w": 8, "x": 8, "y": 6 },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum(rate(rate_limit_hits_total{endpoint=~\"$endpoint\"}[5m])) by (endpoint)",
                    "legendFormat": "{{endpoint}}"
                }
            ],
            "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
        },
        {
            "type": "timeseries",
            "title": "System CPU %",
            "gridPos": { "h": 6, "w": 8, "x": 16, "y": 6 },
            "datasource": "Prometheus",
            "targets": [
                { "expr": "system_cpu_usage_percent", "legendFormat": "cpu" }
            ],
            "fieldConfig": {
                "defaults": { "unit": "percent" },
                "overrides": []
            }
        },
        {
            "type": "stat",
            "title": "Readiness",
            "gridPos": { "h": 6, "w": 6, "x": 0, "y": 12 },
            "datasource": "Prometheus",
            "targets": [{ "expr": "sum(up)", "legendFormat": "up" }],
            "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
        },
        {
            "type": "timeseries",
            "title": "Cache operations",
            "gridPos": { "h": 6, "w": 12, "x": 6, "y": 12 },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum(rate(cache_sets_total[5m])) by (prefix)",
                    "legendFormat": "sets {{prefix}}"
                },
                {
                    "expr": "sum(rate(cache_deletes_total[5m])) by (prefix,mode)",
                    "legendFormat": "deletes {{prefix}}/{{mode}}"
                }
            ],
            "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
        },
        {
            "type": "stat",
            "title": "Requests (5m)",
            "gridPos": { "h": 6, "w": 6, "x": 18, "y": 12 },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum(increase(http_requests_total{endpoint=~\"$endpoint\"}[5m]))",
                    "legendFormat": "requests"
                }
            ],
            "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
        },
        {
            "type": "timeseries",
            "title": "HTTP 5xx rate",
            "gridPos": { "h": 6, "w": 12, "x": 0, "y": 18 },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum(rate(http_requests_total{status_code=~\"5..\", endpoint=~\"$endpoint\"}[5m])) by (endpoint)",
                    "legendFormat": "{{endpoint}}"
                }
            ],
            "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
        },
        {
            "type": "timeseries",
            "title": "HTTP P99 latency (ms)",
            "gridPos": { "h": 6, "w": 12, "x": 12, "y": 18 },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "1000 * histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, method))",
                    "legendFormat": "{{method}}"
                }
            ],
            "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
        },
        {
            "type": "timeseries",
            "title": "Avg sizes (bytes)",
            "gridPos": { "h": 6, "w": 12, "x": 0, "y": 24 },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum(rate(http_request_size_bytes_sum[5m])) / clamp_min(sum(rate(http_request_size_bytes_count[5m])), 1e-9)",
                    "legendFormat": "req_avg"
                },
                {
                    "expr": "sum(rate(http_response_size_bytes_sum[5m])) / clamp_min(sum(rate(http_request_size_bytes_count[5m])), 1e-9)",
                    "legendFormat": "resp_avg"
                }
            ],
            "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
        },
        {
            "type": "timeseries",
            "title": "Redis memory used",
            "gridPos": { "h": 6, "w": 12, "x": 12, "y": 24 },
            "datasource": "Prometheus",
            "targets": [
                { "expr": "redis_memory_used_bytes", "legendFormat": "used" },
                { "expr": "redis_memory_max_bytes", "legendFormat": "max" }
            ],
            "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
        },
        {
            "type": "stat",
            "title": "Redis total keys",
            "gridPos": { "h": 6, "w": 6, "x": 0, "y": 30 },
            "datasource": "Prometheus",
            "targets": [
                { "expr": "sum(redis_db_keys)", "legendFormat": "keys" }
            ],
            "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
        },
        {
            "type": "timeseries",
            "title": "Redis ops/sec",
            "gridPos": { "h": 6, "w": 9, "x": 6, "y": 30 },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "rate(redis_commands_processed_total[1m])",
                    "legendFormat": "ops/sec"
                }
            ],
            "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
        },
        {
            "type": "timeseries",
            "title": "Redis evictions/sec",
            "gridPos": { "h": 6, "w": 9, "x": 15, "y": 30 },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "rate(redis_evicted_keys_total[5m])",
                    "legendFormat": "evictions/sec"
                }
            ],
            "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
        },
        {
            "type": "timeseries",
            "title": "Redis keyspace hit ratio",
            "gridPos": { "h": 6, "w": 12, "x": 0, "y": 36 },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum(rate(redis_keyspace_hits_total[5m])) / clamp_min(sum(rate(redis_keyspace_hits_total[5m])) + sum(rate(redis_keyspace_misses_total[5m])), 1e-9)",
                    "legendFormat": "hit_ratio"
                }
            ],
            "fieldConfig": {
                "defaults": { "unit": "percentunit" },
                "overrides": []
            }
        }
    ]
}
